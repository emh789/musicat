[Unit]
Description=MusiCat Unicorn Server
After=network.target

[Service]
Type=simple
User=musicat
WorkingDirectory=/home/musicat
Environment='RAILS_ENV=production'

# The following Environment attributes are for ruby installations via ruby-install and chruby
Environment='PATH=/home/musicat/.gem/ruby/3.3.0/bin:/home/musicat/.rubies/ruby-3.3.0/lib/ruby/gems/3.3.0/bin:/home/musicat/.rubies/ruby-3.3.0/bin:/usr/bin:/usr/local/bin'
Environment='GEM_ROOT=/home/musicat/.rubies/ruby-3.3.0/lib/ruby/gems/3.3.0'
Environment='GEM_PATH=/home/musicat/.gem/ruby/3.3.0:/home/musicat/.rubies/ruby-3.3.0/lib/ruby/gems/3.3.0'
Environment='GEM_HOME=/home/musicat/.gem/ruby/3.3.0'
Environment='RUBY_ROOT=/home/musicat/.rubies/ruby-3.3.0'

PIDFile=/home/musicat/shared/unicorn.pid
ExecStart=/bin/bash -c 'bundle exec unicorn -c config/unicorn.rb'
ExecReload=/bin/kill -HUP $MAINPID

KillMode=process
KillSignal=SIGQUIT
Restart=on-failure
SyslogIdentifier=musicat

[Install]
WantedBy=multi-user.target
