upstream musicat {
  server unix:/home/musicat/shared/unicorn.socket fail_timeout=0;
}


server {
  listen 80;
  server_name _;

  root /home/musicat/public;
  expires max;

  location ^~ admin/ {
    expires -1;
    try_files $uri @musicat;
  }

  location ^~ /portfolio {
    alias /home/musicat/public/portfolio;
    expires 24h;
  }

  location / {
    try_files $uri/index.html $uri @musicat;
  }

  location @musicat {
    expires -1;
    proxy_pass http://app;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy-set-header X-Forwarded-Server $host;
    proxy_set_header Host $http_host;
    proxy_redirect off;
  }

  error_page 500 502 503 504 /500.html;
  client_max_body_size 4G;
  keepalive_timeout 10;
}
