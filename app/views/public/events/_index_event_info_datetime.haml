.mc_events_index_event_info_datetime
  %a{href: public_event_path(event.id_public), class: :mc_events_index_event_url, title: event.title}
    %span.mc_events_index_event_info_datetime_date
      = event.datetime_local_formatted(:day_month_date_year) + ', '
    %span.mc_events_index_event_info_datetime_time
      = event.datetime_local_formatted(:hour12_min_ampm_zone)
