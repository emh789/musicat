- if event.does_have_coverpicture
  .mc_events_show_coverpicture
    = resource_coverpicture_tag(event, html_class: [:mc_events_show_coverpicture_img, :mc_listening])
    - if event.show_will_have_more_pictures_link
      = render 'shared/show_more_pictures', path: public_event_pictures_path(event.id_public)
