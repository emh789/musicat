.mca_resource_joins_buttons
  = album_keyword_admin_button_to_new_join_single(album)

.mca_resource_pane_title
  = resource_joined_keywords_count_statement(album)
  
- if album.does_have_keywords
  = form_with(model: [:admin, album], url: admin_album_path(album, pane: :keywords), local: true, class: :mca_form, method: :patch) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading title
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :album_keywords, album.album_keywords_sorted do |ak|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= ak.label :keyword_title, keyword_admin_link_title(ak.object.keyword)
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: ak
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also detatch any keywords with '#{icon_destroy}' box checked"
