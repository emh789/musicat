.mca_resource_pane_title
  Upload audio
  
= form_with(model: [:admin, album], local: true, url: admin_album_audio_create_from_upload_path(album), class: :mca_form) do |f|
  .mca_form_attributes
    = f.fields_for :audio, f.object.audio.build do |a|
      = render 'admin/form_fields/file_upload', attribute: :source_uploaded, form: a
  .mca_form_actions
    = f.submit class: :mca_form_submit
