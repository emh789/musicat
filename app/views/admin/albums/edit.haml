= content_for :page_subtitle, 'editing album'
= content_for :page_subtitle_detail, @album.title

.mca_resource_header.resource_edit
  .mca_resource_header_category
    Editing Album
  .mca_resource_header_title
    = @album.title
  .mca_resource_header_buttons
    = album_admin_button_to_edit_previous(@album_neighbors.previous, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
    = album_admin_button_to_done_editing(@album)
    = album_admin_button_to_public(@album)
    = album_admin_button_to_edit_next(@album_neighbors.next, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
  = render 'admin/form_fields/errors', resource: @album

%nav.mca_resource_edit_nav
  - @form_metadata.navbar_categories.each do |category|
    = album_admin_edit_nav_button(album: @album, category: category, current_pane: @form_metadata.current_pane)

.mca_albums_edit.mca_resource_pane
  = render @form_metadata.partial_name, album: @album, selectable: @form_metadata.selectables
