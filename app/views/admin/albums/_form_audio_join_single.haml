.mca_resource_pane_title
  Add audio
  
- if selectable.does_have_audio
  = form_with(model: [:admin, album], url: admin_album_path(album, pane: :audio), local: true, class: :mca_form) do |f|
    .mca_form_attributes
      = f.fields_for :album_audio, album.album_audio.build do |aa|
        = render 'admin/form_fields/collection_select', form: aa, attribute: :audio_id, collection: selectable.audio, label: 'Audio title', text_method: :title_for_display
        = render 'admin/form_fields/text_field_sized', form: aa, attribute: :album_order, label: 'Order', size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No audio.
