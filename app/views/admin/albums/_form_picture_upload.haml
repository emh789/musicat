.mca_resource_pane_title
  Upload picture
  
= form_with(model: [:admin, album], local: true, url: admin_album_picture_create_from_upload_path(album), class: :mca_form) do |f|
  .mca_form_attributes
    = f.fields_for :pictures, f.object.pictures.build do |ap|
      = render 'admin/form_fields/file_upload', attribute: :source_uploaded, form: ap
  .mca_form_actions
    = f.submit class: :mca_form_submit
