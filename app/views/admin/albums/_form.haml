.mca_resource_pane_title
  Album Details
  
= form_with(model: [:admin, album], local: true, class: :mca_form) do |f|
  .mca_form_attributes
    = render 'admin/form_fields/text_field',      attribute: :title,                                    form: f
    = render 'admin/form_fields/visibility',      attribute: :visibility,                               form: f
    = render 'admin/form_fields/auto_keyword',    attribute: :album_keywords,                           form: f
    = render 'admin/form_fields/spacer'
    = render 'admin/form_fields/text_field',      attribute: :album_artist,                             form: f
    = render 'admin/form_fields/parseable_field', attribute: :copyright,                                form: f, selectable: selectable
    = render 'admin/form_fields/date_field',      attribute: :date_released,                            form: f, default_date: Date.current
    = render 'admin/form_fields/parseable_area',  attribute: :description,                              form: f, selectable: selectable
    = render 'admin/form_fields/check_box',       attribute: :index_can_display_tracklist,              form: f
    = render 'admin/form_fields/parseable_area',  attribute: :musicians,                                form: f, selectable: selectable
    = render 'admin/form_fields/parseable_area',  attribute: :personnel,                                form: f, selectable: selectable
    = render 'admin/form_fields/check_box',       attribute: :show_can_cycle_pictures,                  form: f
  .mca_form_actions
    = f.submit class: :mca_form_submit
