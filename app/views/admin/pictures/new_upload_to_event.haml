= content_for :page_subtitle, 'upload picture to event'

.mca_resource_header.resource_new
  .mca_resource_header_category
    Picture Upload to Event

.mca_pictures_new.mca_resource_pane
  = form_with(model: [:admin, @picture], local: true, url: admin_picture_create_from_upload_to_event_path, class: :mca_form) do |f|
    .mca_form_data
      = render 'admin/form_fields/file_field', |
          attribute: :source_uploaded, |
          errors: @picture.errors.messages_for(:source_file), |
          form: f, |
          label: 'Source file'
      = render 'admin/form_fields/auto_keyword', |
          attribute: :picture_keywords, |
          form: f
      = f.fields_for :event_pictures, f.object.event_pictures.build do |ep|
        = render 'admin/form_fields/collection_select', |
            attribute: :event_id, |
            blank: true, |
            collection: @events, |
            errors: @picture.errors.messages_for(:event), |
            form: ep, |
            label: 'Event', |
            text_method: :datetime_and_title
    .mca_form_actions
      = f.submit class: :mca_form_submit
