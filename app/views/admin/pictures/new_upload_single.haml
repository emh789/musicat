= content_for :page_subtitle, 'upload picture single'

.mca_resource_header.resource_new
  .mca_resource_header_category
    Picture Upload

.mca_pictures_new.mca_resource_pane
  = form_with(model: [:admin, @picture], local: true, url: admin_picture_create_from_upload_path, class: :mca_form) do |f|
    .mca_form_attributes
      = render 'admin/form_fields/file_field', |
          attribute: :source_uploaded, |
          errors: @picture.errors.messages_for(:source_file), |
          form: f, |
          label: 'Source file'
      = render 'admin/form_fields/auto_keyword', |
          attribute: :picture_keywords, |
          form: f
    .mca_form_actions
      = f.submit class: :mca_form_submit
