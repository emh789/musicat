.mca_resource_joins_buttons
  = picture_keyword_admin_button_to_new_join_single(picture)

.mca_resource_pane_title
  = resource_joined_keywords_count_statement(picture)

- if picture.does_have_keywords
  = form_with(model: [:admin, picture], url: admin_picture_path(picture, pane: :keywords), local: true, class: :mca_form) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading title
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :picture_keywords, picture.picture_keywords_sorted do |pk|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= pk.label :keyword_title, keyword_admin_link_title(pk.object.keyword)
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: pk
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also detatch any keywords with '#{icon_destroy}' box checked"
