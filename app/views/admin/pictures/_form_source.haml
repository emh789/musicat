.mca_resource_pane_title
  Picture source

= form_with(model: [:admin, picture], url: admin_picture_path(picture, pane: :source), local: true, class: :mca_form) do |f|
  .mca_form_data
    = render 'admin/form_fields/source_select',    attribute: :source_type,               form: f, selectable: selectable
    = render 'admin/form_fields/text_field',       attribute: :source_imported_file_path, form: f, aside: "#{source_imported_dirname(trailing_separator: true)}"
    = render 'admin/form_fields/file_field',       attribute: :source_uploaded,         form: f, purge_path: edit_admin_picture_path(@picture, pane: :source_uploaded_purge)
  .mca_form_actions
    = f.submit class: :mca_form_submit
