.mca_resource_pane_title
  Add keyword

- if selectable.does_have_keywords
  = form_with model: [:admin, picture], url: admin_picture_path(picture, pane: :keywords), local: true, class: :mca_form do |f|
    .mca_form_data
      = f.fields_for :picture_keywords, picture.picture_keywords.build do |pk|
        = render 'admin/form_fields/collection_select', form: pk, attribute: :keyword_id, blank: true, collection: selectable.keywords, label: 'Keyword Title', text_method: :title
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No keywords.
