%fieldset.mca_form_attribute
  = form.label attribute, class: :mca_form_label
  = form.check_box attribute, class: :mca_form_input_checkbox_legacy
  = form.label attribute, '&nbsp;'.html_safe, class: :mca_form_input_checkbox_visible, tabindex: 0
  - if local_assigns[:aside]
    %aside.mca_form_explanation= "#{aside}"
  - if local_assigns[:not_yet_implemented] == true
    .not_yet_implemented
