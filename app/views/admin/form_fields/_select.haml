%fieldset.mca_form_attribute
  = form.label attribute, ( local_assigns[:label] ? label : attribute ), class: :mca_form_label
  = form.select attribute, selectable, { include_blank: local_assigns[:blank], selected: form.object.public_send(attribute) }, { class: :mca_form_input_select }
  - if local_assigns[:aside]
    %aside.mca_form_explanation= "#{aside}"
