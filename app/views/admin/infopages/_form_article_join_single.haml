.mca_resource_pane_title
  Add an article

- if selectable.does_have_articles
  = form_with(model: [:admin, infopage], url: admin_infopage_path(infopage, pane: :articles), local: true, class: :mca_form) do |f|
    .mca_form_data
      = f.fields_for :infopage_articles, f.object.infopage_articles.build do |ia|
        = render 'admin/form_fields/collection_select', form: ia, attribute: :infopageable_id, blank: true, collection: selectable.articles, label: 'Article title', text_method: :title
        = render 'admin/form_fields/select', form: ia, attribute: :infopage_group, blank: true, selectable: selectable.item_groups, label: 'Group'
        = render 'admin/form_fields/text_field_sized', form: ia, attribute: :infopage_group_order, autocomplete: :off, label: 'Order', size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No articles.
