.mca_resource_joins_buttons
  = infopage_link_admin_button_to_new_join_single(infopage)

.mca_resource_pane_title
  = resource_joined_links_count_statement(infopage)

- if infopage.does_have_links
  = form_with(model: [:admin, infopage], url: admin_infopage_path(infopage, pane: :links), local: true, class: :mca_form) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading title
          %th.mca_form_joins_heading group
          %th.mca_form_joins_heading order
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :infopage_items, infopage.infopage_links_sorted do |il|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= link_admin_link_name(il.object.infopageable)
            %td.mca_form_joins_value= il.select :infopage_group, @form_metadata.selectables.item_groups, { selected: il.object.infopage_group }, { class: :mca_form_input_select }
            %td.mca_form_joins_value= il.text_field :infopage_group_order, autocomplete: :off, size: 4, class: :mca_form_input_text_field
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: il
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also detatch any links with '#{icon_destroy}' box checked"
