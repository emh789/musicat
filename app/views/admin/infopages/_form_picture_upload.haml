.mca_resource_pane_title
  Upload picture

= form_with model: [:admin, infopage], local: true, url: admin_infopage_picture_create_from_upload_path(infopage), class: :mca_form do |f|
  .mca_form_attributes
    = f.fields_for :infopage_items, f.object.infopage_pictures.build do |ip|
      = ip.hidden_field :infopageable_type
      = render 'admin/form_fields/file_upload', attribute: :source_uploaded, form: ip
  .mca_form_actions
    = f.submit class: :mca_form_submit
