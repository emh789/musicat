= content_for :page_subtitle, 'editing infopage'
= content_for :page_subtitle_detail, @infopage.title

.mca_resource_header.resource_edit
  .mca_resource_header_category
    Editing Info Page
  .mca_resource_header_title
    = @infopage.title
  .mca_resource_header_buttons
    = infopage_admin_button_to_edit_previous(@infopage_neighbors.previous, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
    = infopage_admin_button_to_done_editing(@infopage)
    = infopage_admin_button_to_public(@infopage)
    = infopage_admin_button_to_edit_next(@infopage_neighbors.next, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
  = render '/admin/form_fields/errors', resource: @infopage

%nav.mca_resource_edit_nav
  - @form_metadata.navbar_categories.each do |category|
    = infopage_admin_edit_nav_button(infopage: @infopage, category: category, current_pane: @form_metadata.current_pane)

.mca_infopage_edit.mca_resource_pane
  = render @form_metadata.partial_name, infopage: @infopage, selectable: @form_metadata.selectables
