.mca_resource_pane_title
  Destroy infopage?
  .mca_form_data_label_destroy= tag.i infopage.title

%ul.mca_form_destroy_explanation
  %li Attached articles, links, and pictures will remain in database and filesystem.

.mca_form_warning This action can not be undone.

= form_with(model: [:admin, infopage], method: :delete, local: true, class: :mca_form) do |f|
  .mca_form_actions
    = f.submit 'Destroy Infopage', data: { confirm: 'Are you sure?' },  class: :mca_form_destroy
