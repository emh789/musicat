.mca_resource_joins_buttons
  = keyword_video_admin_button_to_new_join_single(keyword)

.mca_resource_pane_title
  = resource_joined_videos_count_statement(keyword)

- if keyword.does_have_videos
  = form_with(model: [:admin, keyword], url: admin_keyword_path(keyword, pane: :videos), local: true, class: :mca_form) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading video title
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :video_keywords, keyword.video_keywords_sorted do |vk|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= video_admin_link_title(vk.object.video)
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: vk
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation
        = "will detach any video with the #{icon_remove} box checked."
