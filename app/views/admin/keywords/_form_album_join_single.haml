.mca_resource_pane_title
  Add keyword to album

- if selectable.does_have_albums
  = form_with model: [:admin, keyword], url: admin_keyword_path(keyword, pane: :albums), local: true, class: :mca_form do |f|
    .mca_form_data
      = f.fields_for :album_keyword, keyword.album_keywords.build do |ak|
        = render 'admin/form_fields/collection_select', form: ak, attribute: :album_id, blank: true, collection: selectable.albums, label: 'Album title', text_method: :title
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No albums.
