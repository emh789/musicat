= content_for :page_subtitle, 'editing keyword'
= content_for :page_subtitle_detail, @keyword.title

.mca_resource_header.resource_edit
  .mca_resource_header_category
    Editing Keyword
  .mca_resource_header_title
    = @keyword.title
  .mca_resource_header_buttons
    = keyword_admin_button_to_edit_previous(@keyword_neighbors.previous, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
    = keyword_admin_button_to_done_editing(@keyword)
    = keyword_admin_button_to_edit_next(@keyword_neighbors.next, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
  = render '/admin/form_fields/errors', resource: @keyword

%nav.mca_resource_edit_nav
  - @form_metadata.navbar_categories.each do |category|
    = keyword_admin_edit_nav_button(keyword: @keyword, category: category, current_pane: @form_metadata.current_pane)

.mca_keywords_edit.mca_resource_pane
  = render @form_metadata.partial_name, keyword: @keyword, selectable: @form_metadata.selectables
