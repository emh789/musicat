.mca_resource_pane_title
  Import picture

= form_with model: [:admin, keyword], url: admin_keyword_picture_create_from_import_path(keyword), local: true, class: :mca_form do |f|
  .mca_form_data
    = f.fields_for :pictures, f.object.pictures.build do |p|
      = render 'admin/form_fields/text_field', attribute: :source_imported_file_path, form: p, aside: "#{source_imported_dirname(trailing_separator: true)}"
  .mca_form_actions
    = f.submit class: :mca_form_submit
