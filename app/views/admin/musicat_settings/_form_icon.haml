= form_with model: [:icon, musicat_settings], url: admin_musicat_settings_path(musicat_settings, pane: :icon), local: true, class: :mca_form, method: :patch do |f|
  .mca_resource_pane_title
    Artist Icon
  .mca_form_data
    = render 'admin/form_fields/source_select',   attribute: :icon_source_type,               form: f, selectable: selectable
    = render 'admin/form_fields/text_field',      attribute: :icon_source_imported_file_path, form: f, aside: "#{source_imported_dirname(trailing_separator: true)}"
    = render 'field_file',                        attribute: :icon_image,                     form: f, purge_path: edit_admin_musicat_settings_path(@musicat_settings, pane: :icon_attachment_purge)
  .mca_form_actions
    = f.submit 'Update icon', class: :mca_form_submit
