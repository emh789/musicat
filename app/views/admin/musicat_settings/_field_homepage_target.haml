%fieldset.mca_form_attribute
  - if local_assigns[:label]
    = form.label :public_homepage_target, label, class: :mca_form_label
  - else
    = form.label :public_homepage_target, class: :mca_form_label

  - if local_assigns[:errors]
    %mark.mca_form_errors
      - errors.each do |e|
        .mca_form_error= e

  = form.select :public_homepage_target, targets, { selected: form.object.public_homepage_target }, { class: :mca_form_input_select }
  - if local_assigns[:aside]
    %aside.mca_form_explanation= "#{aside}"
