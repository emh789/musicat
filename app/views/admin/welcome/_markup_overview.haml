.mca_help_markup_overview
  %p.mca_help_markup_overview_summary MusiCat includes three different markup types for text:
  %ul.mca_help_markup_overview_cases
    %li.mca_help_markup_overview_case
      %dl
        %dh.mca_help_markup_overview_case_header Inline text
        %dd.mca_help_markup_overview_case_example Titles and single-phrase descriptions.
        %dd.mca_help_markup_overview_case_example Does not include bold or italic fonts.
        %dd.mca_help_markup_overview_case_example Displayed as a single line, spaces are condensed.
    %li.mca_help_markup_overview_case
      %dl
        %dh.mca_help_markup_overview_case_header Markdown text
        %dd.mca_help_markup_overview_case_example Can have multiple paragraphs.
        %dd.mca_help_markup_overview_case_example Can include bold or italic fonts.
        %dd.mca_help_markup_overview_case_example Can include headings, lists, and links.
    %li.mca_help_markup_overview_case
      %dl
        %dh.mca_help_markup_overview_case_header Plain text
        %dd.mca_help_markup_overview_case_example Can have multiple paragraphs.
        %dd.mca_help_markup_overview_case_example Does not include bold or italic fonts.
