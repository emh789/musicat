    %li associations with other objects
    %li category index
  %hr
  %h3.mca_help_general_content_title
    = 'public – url, join'
  %ul.mca_help_general_content_text
    %li url by direct link
    %li associations with other objects
  %hr
  %h3.mca_help_general_content_title
    = 'public – url'
  %ul.mca_help_general_content_text
    %li url by direct link
  %hr
  %h3.mca_help_general_content_title
    = 'administrators only'
  %ul.mca_help_general_content_text
    %em (cannot be publicly accessed)
  %hr
  %h2.mca_help_general_content_title
    Date released
  %p.mca_help_general_content_text
    If present, a <b>date released</b> or <b>date announced</b> attribute only allows an item's visibility beginning on the chosen date.
