= content_for :page_subtitle, 'help'
= content_for :page_subtitle_detail, 'icons'

.mca_help_general
  %h2.mca_help_general_title Icons

  .mca_help_icons
    .mca_help_icons_example
      .mca_help_icons_example_title New
      .mca_help_icons_example_icon= button_admin_to_new
      .mca_help_icons_example_description Create a new resource item in the database.

    .mca_help_icons_example
      .mca_help_icons_example_title Next
      .mca_help_icons_example_icon= button_admin_to_next
      .mca_help_icons_example_description Open the next indexed resource item.

    .mca_help_icons_example
      .mca_help_icons_example_title Previous
      .mca_help_icons_example_icon= button_admin_to_previous
      .mca_help_icons_example_description Open the previous indexed resource item.

    .mca_help_icons_example
      .mca_help_icons_example_title Edit
      .mca_help_icons_example_icon= button_admin_to_edit
      .mca_help_icons_example_description Open the resource item to make changes.

    .mca_help_icons_example
      .mca_help_icons_example_title Done Editing
      .mca_help_icons_example_icon= button_admin_to_done_editing
      .mca_help_icons_example_description Close the chosen resource to prevent changes.

    .mca_help_icons_example
      .mca_help_icons_example_title Index
      .mca_help_icons_example_icon= button_admin_to_index
      .mca_help_icons_example_description List all items of a resource class.

    .mca_help_icons_example
      .mca_help_icons_example_title Public View
      .mca_help_icons_example_icon= button_admin_to_public
      .mca_help_icons_example_description View the page as it appears publicly. Opens in a new browser tab.

    .mca_help_icons_example
      .mca_help_icons_example_title Join
      .mca_help_icons_example_icon= button_admin_to_new_join_single
      .mca_help_icons_example_description Associate the current item with another resource. Opens a new page to make a selection.

    .mca_help_icons_example
      .mca_help_icons_example_title Import
      .mca_help_icons_example_icon= button_admin_to_new_import
      .mca_help_icons_example_description Build a new resource from a file on the server in the <em>imported</em> folder. Opens a new page to enter a filepath.

    .mca_help_icons_example
      .mca_help_icons_example_title Upload
      .mca_help_icons_example_icon= button_admin_to_new_upload
      .mca_help_icons_example_description Build a new resource by uploading a file from the local computer. Opens a new page to select a file.

    .mca_help_icons_example
      .mca_help_icons_example_title Join by keyword
      .mca_help_icons_example_icon= button_admin_to_new_join_by_keyword
      .mca_help_icons_example_description Associate the current item with a collection of resources chosen by keyword. Opens a new page to choose a keyword.
