.mca_resource_joins_buttons
  = event_audio_admin_button_to_new_join_single(event)
  = event_audio_admin_button_to_new_import(event)
  = event_audio_admin_button_to_new_upload(event)
  = event_audio_admin_button_to_new_join_by_keyword(event)

.mca_resource_pane_title
  = resource_joined_audio_count_statement(event)

- if event.does_have_audio
  = form_with(model: [:admin, event], url: admin_event_path(event, pane: :audio), local: true, class: :mca_form) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading title
          %th.mca_form_joins_heading order
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :event_audio, event.event_audio_sorted do |ea|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= audio_admin_link_title(ea.object.audio)
            %td.mca_form_joins_value= ea.text_field :event_order, autocomplete: :off, size: 4, class: :mca_form_input_number_field
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: ea
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also remove any audio with '#{icon_destroy}' box checked"
