.mca_resource_pane_title
  Add a keyword

- if selectable.does_have_keywords
  = form_with model: [:admin, event], url: admin_event_path(event, pane: :keywords), local: true, class: :mca_form do |f|
    .mca_form_attributes
      = f.fields_for :event_keywords, event.event_keywords.build do |ek|
        = render 'admin/form_fields/collection_select', form: ek, attribute: :keyword_id, blank: true, collection: selectable.keywords, label: 'Keyword', text_method: :title
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No keywords.
