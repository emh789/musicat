.mca_resource_pane_title
  Add audio

- if selectable.does_have_audio
  = form_with(model: [:admin, event], url: admin_event_path(event, pane: :audio), local: true, class: :mca_form) do |f|
    .mca_form_attributes
      = f.fields_for :event_audio, event.event_audio.build do |ea|
        = render 'admin/form_fields/collection_select', form: ea, attribute: :audio_id, blank: true, collection: selectable.audio, label: 'Audio title', text_method: :title_for_display
        = render 'admin/form_fields/text_field_sized', form: ea, attribute: :event_order, label: 'Order', size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No audio.
