.mca_resource_joins_buttons
  = event_video_admin_button_to_new_join_single(event)
  -# event_video_admin_button_to_new_import(event)
  -# event_video_admin_button_to_new_upload(event)
  = event_video_admin_button_to_new_join_by_keyword(event)

.mca_resource_pane_title
  = resource_joined_videos_count_statement(event)

- if event.does_have_videos
  = form_with(model: [:admin, event], url: admin_event_path(event, pane: :videos), local: true, class: :mca_form) do |f|
    .mca_form_data
      %table.mca_form_joins
        %thead
          %tr.mca_form_joins_headings
            %th.mca_form_joins_heading title
            %th.mca_form_joins_heading order
            %th.mca_form_joins_heading= icon_remove
        %tbody
          = f.fields_for :event_videos, event.event_videos_sorted do |ev|
            %tr.mca_form_joins_values
              %td.mca_form_joins_value= ev.label :video_title, video_admin_link_title(ev.object.video)
              %td.mca_form_joins_value= ev.text_field :event_order, autocomplete: :off, size: 4, class: :mca_form_input_number_field
              %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: ev
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also detach any videos with '#{icon_destroy}' box checked"
