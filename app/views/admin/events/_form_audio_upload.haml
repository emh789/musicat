.mca_resource_pane_title
  Upload audio

= form_with model: [:admin, event], local: true, method: :post, url: admin_event_audio_create_from_upload_path(event), class: :mca_form do |f|
  .mca_form_attributes
    = f.fields_for :audio, f.object.audio.build do |e|
      = render 'admin/form_fields/file_upload', attribute: :source_uploaded, form: e
  .mca_form_actions
    = f.submit class: :mca_form_submit
