.mca_resource_pane_title
  Add video

- if selectable.does_have_videos
  = form_with(model: [:admin, event], url: admin_event_path(event, pane: :videos), local: true, class: :mca_form) do |f|
    .mca_form_attributes
      = f.fields_for :event_videos, event.event_videos.build do |ev|
        = render 'admin/form_fields/collection_select', form: ev, attribute: :video_id, blank: true, collection: selectable.videos, label: 'Title', text_method: :title_for_display
        = render 'admin/form_fields/text_field_sized', form: ev, attribute: :event_order, label: 'Order', size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No videos.
