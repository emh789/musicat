.mca_resource_pane_title
  Upload picture

= form_with model: [:admin, event], local: true, url: admin_event_picture_create_from_upload_path(event), class: :mca_form do |f|
  .mca_form_attributes
    = f.fields_for :pictures, f.object.pictures.build do |e|
      = render 'admin/form_fields/file_upload', attribute: :source_uploaded, form: e
  .mca_form_actions
    = f.submit class: :mca_form_submit
