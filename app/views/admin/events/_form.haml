.mca_resource_pane_title
  Event details

= form_with(model: [:admin, event], local: true, class: :mca_form) do |f|
  .mca_form_data
    = render 'admin/form_fields/parseable_field',     form: f, attribute: :title, selectable: selectable
    = render 'admin/form_fields/datetimezone_field',  form: f, attribute: :datetime_utc, zone: :datetime_zone, heading: 'Date and time of event start', selectable: selectable
    = render 'admin/form_fields/visibility',          form: f, attribute: :visibility
    = render 'admin/form_fields/auto_keyword',        form: f, attribute: :event_keywords
    = render 'admin/form_fields/spacer'
    = render 'admin/form_fields/text_field',          form: f, attribute: :alert
    = render 'admin/form_fields/text_field',          form: f, attribute: :city
    = render 'admin/form_fields/parseable_area',      form: f, attribute: :details, selectable: selectable
    = render 'admin/form_fields/text_field',          form: f, attribute: :map_url
    = render 'admin/form_fields/check_box',           form: f, attribute: :show_can_cycle_pictures
    -# render 'admin/form_fields/check_box',          form: f, attribute: :show_can_have_more_pictures_link
    = render 'admin/form_fields/text_field',          form: f, attribute: :venue
    = render 'admin/form_fields/text_field',          form: f, attribute: :venue_url
  .mca_form_actions
    = f.submit class: :mca_form_submit
