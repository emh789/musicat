= content_for :page_subtitle, 'upload audio to album'

.mca_resource_header.resource_new
  .mca_resource_header_category
    Upload Audio to Album

.mca_audio_new.mca_resource_pane
  = form_with(model: [:admin, @audio], local: true, url: admin_audio_create_from_upload_to_album_path, class: :mca_form) do |f|
    .mca_form_attributes
      = render 'admin/form_fields/file_field', |
          attribute: :source_uploaded, |
          errors: @audio.errors.messages_for(:source_file), |
          form: f, |
          label: 'Source file'
      = render 'admin/form_fields/auto_keyword', |
          attribute: :audio_keywords, |
          form: f
      = f.fields_for :album_audio, f.object.album_audio.build do |aa|
        = render 'admin/form_fields/collection_select', |
            attribute: :album_id, |
            blank: true, |
            collection: @albums, |
            errors: @audio.errors.messages_for(:album), |
            form: aa, |
            label: 'Album', |
            text_method: :title
        = render 'admin/form_fields/text_field_sized', |
            attribute: :album_order, |
            autocomplete: false, |
            form: aa, |
            label: 'Order', |
            size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit
