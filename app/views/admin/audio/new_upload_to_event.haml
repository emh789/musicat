= content_for :page_subtitle, 'upload audio to event'

.mca_resource_header.resource_new
  .mca_resource_header_category
    Upload Audio to Event

.mca_audio_new.mca_resource_pane
  = form_with(model: [:admin, @audio], local: true, url: admin_audio_create_from_upload_to_event_path, class: :mca_form) do |f|
    .mca_form_attributes
      = render 'admin/form_fields/file_field', |
          attribute: :source_uploaded, |
          errors: @audio.errors.messages_for(:source_file), |
          form: f, |
          label: 'Source file'
      = render 'admin/form_fields/auto_keyword', |
          attribute: :audio_keywords, |
          form: f
      = f.fields_for :event_audio, f.object.event_audio.build do |ea|
        = render 'admin/form_fields/collection_select', |
            attribute: :event_id, |
            blank: true, |
            collection: @events, |
            errors: @audio.errors.messages_for(:event), |
            form: ea, |
            label: 'Event', |
            text_method: :datetime_and_title
        = render 'admin/form_fields/text_field_sized', |
            attribute: :event_order, |
            autocomplete: false, |
            form: ea, |
            label: 'Order', |
            size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit
