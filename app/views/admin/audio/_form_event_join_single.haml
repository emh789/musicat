.mca_resource_pane_title
  Add audio to event

- if selectable.does_have_events
  = form_with model: [:admin, audio], url: admin_audio_path(audio, pane: :events), local: true, class: :mca_form do |f|
    .mc_form_data
      = f.fields_for :event_audio, audio.event_audio.build do |ea|
        = render 'admin/form_fields/collection_select', form: ea, attribute: :event_id, blank: true, collection: selectable.events, label: 'Event date/title', text_method: :datetime_and_title
        = render 'admin/form_fields/text_field_sized', form: ea, attribute: :event_order, autocomplete: false, label: 'Order', size: 4
    .mc_form_actions
      = f.submit class: :mca_form_submit

- else
  .mc_form
    .mc_form_null No events.
