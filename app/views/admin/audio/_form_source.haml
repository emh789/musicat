= form_with(model: [:admin, audio], url: admin_audio_path(audio, pane: :source), local: true, class: :mca_form) do |f|
  .mca_resource_pane_title
    Audio source
  .mca_form_attributes
    = render 'admin/form_fields/source_select',    attribute: :source_type,               form: f, selectable: selectable
    = render 'admin/form_fields/text_field',       attribute: :source_imported_file_path, form: f, aside: "#{source_imported_dirname(trailing_separator: true)}"
    = render 'admin/form_fields/file_field',       attribute: :source_uploaded,           form: f, purge_path: edit_admin_audio_path(audio, pane: :source_uploaded_purge)
    -#= render 'admin/form_fields/text_field',       attribute: :source_url,                form: f, aside_before: "imported/#{imported_path_suffix_audio}/"
  .mca_form_actions
    = f.submit class: :mca_form_submit
