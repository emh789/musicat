= content_for :page_subtitle, 'editing link'
= content_for :page_subtitle_detail, @link.name

.mca_resource_header.resource_edit
  .mca_resource_header_category
    Editing Link
  .mca_resource_header_title
    = @link.title
  .mca_resource_header_buttons
    = link_admin_button_to_edit_previous(@link_neighbors.previous, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
    = link_admin_button_to_done_editing(@link)
    = link_admin_button_to_edit_next(@link_neighbors.next, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
  = render '/admin/form_fields/errors', resource: @link

%nav.mca_resource_edit_nav
  - @form_metadata.navbar_categories.each do |category|
    = link_admin_edit_nav_button(link: @link, category: category, current_pane: @form_metadata.current_pane)

.mca_links_edit.mca_resource_pane
  = render @form_metadata.partial_name, link: @link, selectable: @form_metadata.selectables
