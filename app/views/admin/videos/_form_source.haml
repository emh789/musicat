.mca_resource_pane_title
  Video source

= form_with(model: [:admin, video], url: admin_video_path(video, pane: :source), local: true, class: :mca_form, method: :patch) do |f|
  .mca_form_attributes
    = render 'admin/form_fields/source_select', attribute: :source_type,               form: f, selectable: selectable
    = render 'admin/form_fields/file_field',    attribute: :source_uploaded,           form: f
    = render 'admin/form_fields/text_field',    attribute: :source_imported_file_path, form: f, aside: "#{source_imported_dirname(trailing_separator: true)}"
    = render 'admin/form_fields/text_area',     attribute: :source_embed,              form: f, aside: 'Remove width and height attributes to automatically resize the video to the width of the viewer\'s device.'
    -# = render 'admin/form_fields/text_field',    attribute: :source_url,                form: f, aside: "#{source_imported_path_prefix_url}/"
  .mca_form_actions
    = f.submit class: :mca_form_submit
