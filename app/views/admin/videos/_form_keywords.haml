.mca_resource_joins_buttons
  = video_keyword_admin_button_to_new_join_single(video)

.mca_resource_pane_title
  = resource_joined_keywords_count_statement(video)

- if video.does_have_keywords
  = form_with(model: [:admin, video], url: admin_video_path(video, pane: :keywords), local: true, class: :mca_form) do |f|
    %table.mca_form_joins
      %thead
        %tr.mca_form_joins_headings
          %th.mca_form_joins_heading keyword title
          %th.mca_form_joins_heading= icon_remove
      %tbody
        = f.fields_for :video_keywords, video.video_keywords_sorted do |vk|
          %tr.mca_form_joins_values
            %td.mca_form_joins_value= keyword_admin_link_title(vk.object.keyword)
            %td.mca_form_joins_value= render 'admin/form_fields/destroy_box', form: vk
    .mca_form_actions
      = f.submit class: :mca_form_submit
      %aside.mca_form_explanation= "will also detach any keywords with 'remove' box checked"
