.mca_resource_pane_title
  Add event

- if selectable.does_have_events
  = form_with(model: [:admin, video], url: admin_video_path(video, pane: :events), local: true, class: :mca_form) do |f|
    .mca_form_data
      = f.fields_for :event_videos, video.event_videos.build do |ev|
        = render 'admin/form_fields/collection_select', form: ev, attribute: :event_id, blank: true, collection: selectable.events, label: 'Event date/title', text_method: :datetime_and_title
        = render 'admin/form_fields/text_field_sized', form: ev, attribute: :event_order, label: 'Order', size: 4
    .mca_form_actions
      = f.submit class: :mca_form_submit

- else
  .mca_form
    .mca_form_null No events.
