= content_for :page_subtitle, 'editing video'
= content_for :page_subtitle_detail, @video.title

.mca_resource_header.resource_edit
  .mca_resource_header_category
    Editing Video
  .mca_resource_header_title
    = @video.title
  .mca_resource_header_buttons
    = video_admin_button_to_edit_previous(@video_neighbors.previous, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
    = video_admin_button_to_done_editing(@video)
    = video_admin_button_to_edit_next(@video_neighbors.next, musicat_settings: @musicat_settings, current_pane: @form_metadata.current_pane)
  = render '/admin/form_fields/errors', resource: @video

%nav.mca_resource_edit_nav
  - @form_metadata.navbar_categories.each do |category|
    = video_admin_edit_nav_button(video: @video, category: category, current_pane: @form_metadata.current_pane)

.mca_videos_edit.mca_resource_pane
  = render @form_metadata.partial_name, video: @video, selectable: @form_metadata.selectables
