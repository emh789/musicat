= content_for :page_subtitle, 'videos'

.mca_resource_header.resource_index
  .mca_resource_header_category
    Videos Index
  .mca_resource_header_buttons
    = video_admin_button_to_public

.mca_videos_index
  .mca_videos_index_filter
    = form_with model: @musicat_settings, url: admin_musicat_settings_update_and_return_path, local: true do |f|
      = video_admin_filter_select(f, params, class: [:mc_active_filter, :mca_videos_index_filter_select])
      = f.submit icon_pin, class: :mca_form_aux_submit

  .mca_videos_index_videos
    - @videos.each do |video|
      .mca_videos_index_video
        .mca_videos_index_video_coverpicture
          = resource_coverpicture_tag(video, html_class: :mca_videos_index_video_coverpicture_thumbnail)
        .mca_videos_index_video_title
          = video_admin_link_title(video)
        .mca_videos_index_video_resources
          %dl.mca_index_joined_resources
            = render 'admin/shared/index_joined_keywords', resource: video
            = render 'admin/shared/index_joined_pictures', resource: video
        .mca_videos_index_video_datetime
          = video.date_released
        .mca_videos_index_video_visibility
          = visibility_description(video.visibility)
