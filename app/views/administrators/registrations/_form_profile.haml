.mca_resource_pane_title
  Administrator profile

= form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: :mca_form, method: :put } do |f|
  .mca_form_attributes
    .mca_form_attribute
      = f.label :name, class: :mca_form_label
      = f.text_field :name, size: 40, class: :mca_form_input_text_field
    .mca_form_attribute
      = f.label :email, class: :mca_form_label
      = f.email_field :email, class: :mca_form_input_text_field
    .mca_form_attribute
      = f.label :has_authority_to_write, class: :mca_form_label
      = f.check_box :has_authority_to_write, class: :mca_form_input_checkbox_legacy
      = f.label :has_authority_to_write, '&nbsp;'.html_safe, class: :mca_form_input_checkbox_visible, tabindex: 0
      %aside.mca_form_explanation This can only be changed from the server command line.
    .mca_form_attribute
      = f.label :current_password, class: :mca_form_label
      %aside.mca_form_explanation
        (current password required to confirm your changes)
      = f.password_field :current_password, autocomplete: 'off', class: :mca_form_input_text_field

  .mca_form_actions
    = f.submit 'Update Administrator', class: :mca_form_submit
