.mca_resource_pane_title
  Administrator password

= form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: :mca_form, method: :put } do |f|
  .mca_form_attributes
    .mca_form_attribute
      = f.label :current_password, class: :mca_form_label
      = f.password_field :current_password, autocomplete: 'off', class: :mca_form_input_text_field
    .mca_form_attribute
      = f.label :password, 'New password', class: :mca_form_label
      = f.password_field :password, autocomplete: 'off', class: :mca_form_input_text_field
    .mca_form_attribute
      = f.label :password_confirmation, 'New password confirmation', class: :mca_form_label
      = f.password_field :password_confirmation, autocomplete: 'off', class: :mca_form_input_text_field

  .mca_form_actions
    = f.submit 'Update Administrator', class: :mca_form_submit
